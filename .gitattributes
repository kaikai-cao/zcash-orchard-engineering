# The vendored instrumentation patch must stay byte-exact so `patch -p1` applies;
# with core.autocrlf=true a text diff would get CRLF-rewritten on checkout.
*.patch -text

# Raw measurement records: keep exactly what the tools wrote.
results/**/*.txt -text
results/**/*.log -text
results/**/*.csv text eol=lf

# Files whose sha256 is recorded in f0_freeze/manifest.json must land as LF on
# checkout, otherwise the frozen hashes cannot be re-verified from a clone.
results/transaction_e2e/f0_freeze/Cargo.lock.frozen text eol=lf
**/Cargo.lock text eol=lf
experiments/transaction_e2e/vendor/** text eol=lf

# Must stay last: the vendor rule above would otherwise re-enable EOL conversion.
*.patch -text
