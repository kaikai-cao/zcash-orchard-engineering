+++ b/experiments/transaction_e2e/vendor/halo2_proofs-0.4.0/src/f4a_impl.rs
@@ -0,0 +1,149 @@
+//! Stage F4-A: bookkeeping for the shared selector-recovery chains.
+//!
+//! `compress_selectors` rewrites every packed virtual selector `q` as
+//! `q * prod_i (r_i - q)`. Constraints that used `q` each carry their own copy
+//! of that product, so the prover recomputes the same chain once per consumer.
+//! [`crate::poly::intern_chains`] replaces the root-position copies with
+//! `Ast::Memo(slot)`; the evaluator fills one memo slot per chunk before the
+//! walk. This module is only the switch and the counters — the mechanism lives
+//! in `poly/evaluator.rs`.
+//!
+//! **Off by default.** `ORCHARD_F4A=1` turns it on, so a build that has the
+//! patch applied but the variable unset is behaviourally identical to the
+//! baseline. That is what makes the A/B a same-binary comparison: `A` and `B`
+//! differ by one environment variable and nothing else.
+//!
+//! `ORCHARD_F4A_STATS=1` additionally counts memo reads. The counters are off
+//! during the timing runs (a relaxed load per memo visit is cheap but not free,
+//! and there is no reason to pay it while measuring).
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+fn var(name: &str) -> Option<String> {
+    std::env::var_os(name).map(|v| v.to_string_lossy().into_owned())
+}
+
+fn flag(name: &str) -> bool {
+    matches!(var(name).as_deref(), Some("1") | Some("true"))
+}
+
+/// Whether the chain interning is on for the *next* proof.
+///
+/// Deliberately not cached: it costs one `getenv` per proof, and re-reading it
+/// lets a single process alternate `A` and `B` proofs, which removes the
+/// process-start and allocator-state drift that separate runs would add on top
+/// of the machine drift already measured (doc 23 §10.3).
+pub fn enabled() -> bool {
+    flag("ORCHARD_F4A")
+}
+
+/// Whether the per-visit counters are on.
+fn stats_enabled() -> bool {
+    flag("ORCHARD_F4A_STATS")
+}
+
+static CHAINS: AtomicU64 = AtomicU64::new(0);
+static SLOTS: AtomicU64 = AtomicU64::new(0);
+static ROOT_CONSUMERS: AtomicU64 = AtomicU64::new(0);
+static CHAIN_MULS: AtomicU64 = AtomicU64::new(0);
+static SAVED_MULS: AtomicU64 = AtomicU64::new(0);
+
+static CHUNKS_FILLED: AtomicU64 = AtomicU64::new(0);
+static SLOT_FILLS: AtomicU64 = AtomicU64::new(0);
+static MEMO_READS: AtomicU64 = AtomicU64::new(0);
+
+static STATS_ON: AtomicBool = AtomicBool::new(false);
+
+/// Records what `intern_chains` decided, once per proof.
+///
+/// - `chains`: distinct root-position chains found (shared or not)
+/// - `slots`: chains with more than one consumer, i.e. memo slots
+/// - `root_consumers`: `sum over chains of occurrences`
+/// - `chain_muls`: `sum over chains of occ * (k - 1)` — the baseline's work
+/// - `saved_muls`: `sum over shared chains of (occ - 1) * (k - 1)` — the
+///   structural reduction, `structural_mul_eliminations` in doc 23 §10.2
+pub fn record_intern(
+    chains: usize,
+    slots: usize,
+    root_consumers: u64,
+    chain_muls: u64,
+    saved_muls: u64,
+    per_slot: Vec<(u32, u32)>,
+) {
+    STATS_ON.store(stats_enabled(), Ordering::Relaxed);
+    CHAINS.store(chains as u64, Ordering::Relaxed);
+    SLOTS.store(slots as u64, Ordering::Relaxed);
+    ROOT_CONSUMERS.store(root_consumers, Ordering::Relaxed);
+    CHAIN_MULS.store(chain_muls, Ordering::Relaxed);
+    SAVED_MULS.store(saved_muls, Ordering::Relaxed);
+    if STATS_ON.load(Ordering::Relaxed) {
+        let body = per_slot
+            .iter()
+            .map(|(k, occ)| format!("[{},{}]", k, occ))
+            .collect::<Vec<_>>()
+            .join(",");
+        println!("F4A_CHAINS {{\"slots\":{},\"k_occ\":[{}]}}", per_slot.len(), body);
+    }
+}
+
+/// One call per chunk that had slots to fill (V1: the fill loop covers `0..n`).
+pub fn note_chunk_filled(_chunk_index: usize, n_slots: usize) {
+    if !STATS_ON.load(Ordering::Relaxed) {
+        return;
+    }
+    CHUNKS_FILLED.fetch_add(1, Ordering::Relaxed);
+    SLOT_FILLS.fetch_add(n_slots as u64, Ordering::Relaxed);
+}
+
+/// One call per `Ast::Memo` visited (V2: every visit is an initialised slot —
+/// the index is bounds-checked by `ctx.memo[slot]` itself).
+pub fn note_memo_read(_chunk_index: usize, _slot: usize) {
+    if !STATS_ON.load(Ordering::Relaxed) {
+        return;
+    }
+    MEMO_READS.fetch_add(1, Ordering::Relaxed);
+}
+
+static H_FNV: AtomicU64 = AtomicU64::new(0);
+
+/// FNV-1a over the canonical byte encoding of `h`'s coefficients (P4: the A/B
+/// must agree on every coefficient, not just on the proof bytes).
+pub fn note_h_poly<F: ff::PrimeField>(coeffs: &[F]) {
+    // Reads the env directly rather than `STATS_ON`, because arm `A` never
+    // reaches `record_intern` and would otherwise inherit arm `B`'s hash.
+    if !stats_enabled() {
+        return;
+    }
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for c in coeffs {
+        let repr = c.to_repr();
+        for b in repr.as_ref() {
+            h ^= *b as u64;
+            h = h.wrapping_mul(0x100_0000_01b3);
+        }
+    }
+    H_FNV.store(h, Ordering::Relaxed);
+}
+
+/// `F4A_IMPL {…}` for the harness to print.
+pub fn report() -> String {
+    let slots = SLOTS.load(Ordering::Relaxed);
+    let chunks = CHUNKS_FILLED.load(Ordering::Relaxed);
+    format!(
+        "{{\"enabled\":{},\"stats\":{},\"chains\":{},\"slots\":{},\"root_consumers\":{},\
+\"chain_muls\":{},\"structural_mul_eliminations\":{},\"chunks_filled\":{},\
+\"slot_fills\":{},\"memo_reads\":{},\"slot_fills_per_chunk\":{},\"h_fnv\":\"0x{:016x}\"}}",
+        enabled(),
+        STATS_ON.load(Ordering::Relaxed),
+        CHAINS.load(Ordering::Relaxed),
+        slots,
+        ROOT_CONSUMERS.load(Ordering::Relaxed),
+        CHAIN_MULS.load(Ordering::Relaxed),
+        SAVED_MULS.load(Ordering::Relaxed),
+        chunks,
+        SLOT_FILLS.load(Ordering::Relaxed),
+        MEMO_READS.load(Ordering::Relaxed),
+        if chunks == 0 { 0 } else { SLOT_FILLS.load(Ordering::Relaxed) / chunks },
+        H_FNV.load(Ordering::Relaxed),
+    )
+}
