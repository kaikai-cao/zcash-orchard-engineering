+// ---------------------------------------------------------------------------
+// Stage F4-A: share the duplicated selector-recovery chains
+// ---------------------------------------------------------------------------
+//
+// `ConstraintSystem::compress_selectors` rewrites every virtual selector `q`
+// that got packed into a fixed column as `q * prod_i (r_i - q)`, where `r_i`
+// are the other members of the same column. Every constraint that used `q` now
+// carries its own copy of that product, so the 56 virtual selectors become 869
+// whole-chunk multiplications of identical work (doc 21 §5, doc 23 §2).
+//
+// `intern_chains` replaces each *root-position* copy with `Ast::Memo(slot)` and
+// hands the subtree itself to the evaluator, which computes it once per chunk.
+// Nothing else about the tree changes: the 193 constraints stay, the expression
+// nodes that remain keep their shape and their evaluation order, and a chain
+// with a single consumer is not touched at all.
+
+/// Splits a node into `q * f1 * ... * f_{k-1}` -- the left spine of a
+/// selector-recovery product -- returning the shared fixed leaf and the roots in
+/// spine order.
+fn as_recovery_chain<E, F: WithSmallOrderMulGroup<3>, B: Basis>(
+    e: &Ast<E, F, B>,
+) -> Option<(usize, Vec<F>)> {
+    let mut factors: Vec<&Ast<E, F, B>> = Vec::new();
+    let mut cur = e;
+    while let Ast::Mul(AstMul(a, b)) = cur {
+        factors.push(b.as_ref());
+        cur = a.as_ref();
+    }
+    // The spine has to bottom out on the compressed column itself, unrotated.
+    let leaf = match cur {
+        Ast::Poly(l) if l.rotation.0 == 0 => l.index,
+        _ => return None,
+    };
+    if factors.is_empty() {
+        return None;
+    }
+
+    let mut roots = Vec::with_capacity(factors.len());
+    for f in &factors {
+        roots.push(as_chain_factor(f, leaf)?);
+    }
+
+    // `k - 1` roots over `{1, ..., k}` minus this selector's own position: the
+    // same predicate the feasibility probe used (doc 22 §8.1), so a chain found
+    // here is a chain counted there.
+    let k = roots.len() + 1;
+    for (i, a) in roots.iter().enumerate() {
+        let mut in_range = false;
+        for j in 1..=k {
+            if *a == F::from(j as u64) {
+                in_range = true;
+                break;
+            }
+        }
+        if !in_range {
+            return None;
+        }
+        for b in roots.iter().skip(i + 1) {
+            if a == b {
+                return None;
+            }
+        }
+    }
+    Some((leaf, roots))
+}
+
+/// Matches `Constant(r) - Fixed(leaf)`, which the baseline builds as
+/// `Add(ConstantTerm(r), Scale(Poly(leaf), -1))`.
+fn as_chain_factor<E, F: WithSmallOrderMulGroup<3>, B: Basis>(
+    e: &Ast<E, F, B>,
+    leaf: usize,
+) -> Option<F> {
+    let (a, b) = match e {
+        Ast::Add(a, b) => (a.as_ref(), b.as_ref()),
+        _ => return None,
+    };
+    for (x, y) in [(a, b), (b, a)] {
+        if let (Ast::ConstantTerm(r), Ast::Scale(inner, scalar)) = (x, y) {
+            if *scalar != -F::ONE {
+                continue;
+            }
+            if let Ast::Poly(l) = inner.as_ref() {
+                if l.index == leaf && l.rotation.0 == 0 {
+                    return Some(*r);
+                }
+            }
+        }
+    }
+    None
+}
