+        shared_out.len(),
+        root_occ_total,
+        chain_muls,
+        saved_muls,
+        per_slot,
+    );
+
+    if shared_out.is_empty() {
+        return (exprs, Vec::new());
+    }
+
+    // Pass 3: rewrite. `Memo` only ever lands in a root position (F4A-2).
+    let lookup = |e: &Ast<E, F, B>| -> Option<(RootPos, u16)> {
+        let (pos, key) = at_root(e)?;
+        let idx = keys.iter().position(|k| *k == key)?;
