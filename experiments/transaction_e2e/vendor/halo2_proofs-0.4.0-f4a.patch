+    // Pass 2: keep only the chains that actually repeat.
+    let mut remap: Vec<Option<u16>> = vec![None; keys.len()];
+    let mut shared_out: Vec<Ast<E, F, B>> = Vec::new();
+    let mut chain_muls = 0u64;
+    let mut saved_muls = 0u64;
+    let mut root_occ_total = 0u64;
+    let mut per_slot: Vec<(u32, u32)> = Vec::new();
+    for (i, key) in keys.iter().enumerate() {
+        let k = (key.1.len() + 1) as u64;
