+/// Where a chain sits relative to its constraint.
+#[derive(Clone, Copy)]
+enum RootPos {
+    /// The whole constraint expression is the chain.
+    Whole,
+    /// The chain is the left operand of the constraint's root product.
+    Left,
+    /// The chain is the right operand of the constraint's root product.
+    Right,
+}
+
+/// The chain a node is, together with the position it occupies.
+fn at_root<E, F: WithSmallOrderMulGroup<3>, B: Basis>(
+    e: &Ast<E, F, B>,
+) -> Option<(RootPos, (usize, Vec<F>))> {
+    if let Some(key) = as_recovery_chain(e) {
+        return Some((RootPos::Whole, key));
+    }
+    if let Ast::Mul(AstMul(a, b)) = e {
+        if let Some(key) = as_recovery_chain(a) {
+            return Some((RootPos::Left, key));
+        }
+        if let Some(key) = as_recovery_chain(b) {
+            return Some((RootPos::Right, key));
+        }
+    }
+    None
+}
+
+fn subtree_of<'a, E, F: Field, B: Basis>(
+    e: &'a Ast<E, F, B>,
+    pos: RootPos,
+) -> Option<&'a Ast<E, F, B>> {
+    match (pos, e) {
+        (RootPos::Whole, _) => Some(e),
+        (RootPos::Left, Ast::Mul(AstMul(a, _))) => Some(a.as_ref()),
+        (RootPos::Right, Ast::Mul(AstMul(_, b))) => Some(b.as_ref()),
+        _ => None,
+    }
+}
