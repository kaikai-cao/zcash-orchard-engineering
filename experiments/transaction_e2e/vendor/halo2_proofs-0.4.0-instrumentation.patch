# Six hooks, no algorithmic change:
#   src/lib.rs            + pub mod f2
#   src/f2.rs             new: accounting + report plumbing
#   src/plonk.rs          + VerifyingKey::cs_f2() accessor
#   src/plonk/keygen.rs   + f2::maybe_run(&vk) at end of keygen_vk
#   src/plonk/prover.rs   + E2 phase timers, E3 stage codes, F2 term counters
#   src/poly/evaluator.rs + evaluate wrapper (counts + timing) and Ast accounting
