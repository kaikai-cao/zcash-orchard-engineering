+            assert_matches_reference::<LagrangeCoeff>("lagrange/leaf", 6, &three, |l| {
+                l[0].clone()
+            });
+            assert_matches_reference::<LagrangeCoeff>("lagrange/sum", 6, &three, |l| {
+                (l[0].clone() * l[1].clone()) + l[2].clone()
+            });
+            assert_matches_reference::<LagrangeCoeff>("lagrange/distribute", 6, &three, |l| {
+                Ast::distribute_powers(
+                    vec![l[0].clone(), -l[1].clone(), Ast::LinearTerm(Base::from(2))],
+                    Base::from(3),
+                )
+            });
+        }
+    }
