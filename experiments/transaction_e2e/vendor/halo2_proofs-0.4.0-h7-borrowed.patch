+//! Stage F3 / H7 diagnostics: who allocates, and how much gets written.
+//!
+//! Inert unless `ORCHARD_H7` is set. The counters here are the *mechanism* data
+//! for the `Borrowed`/`Owned` rewrite: how many leaf visits end up as a borrow
+//! versus a copy, how many fresh buffers `recurse` creates, and how many bytes
+//! those buffers amount to. They are incremented from inside the new evaluator,
+//! at the four places that can allocate, so the totals close against the tree
+//! shape rather than being estimated from it:
+//!
+//! ```text
+//! leaf_borrowed + leaf_copied            == leaf_visits
+//! allocations                            == leaf_copied + constant + linear
+//!                                           + distribute + both_borrowed
+//! ```
+//!
+//! `ORCHARD_H7_BENCH=n` additionally prices the two formulations of a two-input
+//! node (`copy both, then multiply in place` against `collect over a zip`) on
+//! real field elements, single threaded, *after* the evaluation it is attached
+//! to. That number is an independent check on the end-to-end result: it says
+//! whether the rewrite can be cheaper per element at all, without any of the
+//! prover's other work in the way.
+//!
+//! This is measurement scaffolding in a vendored copy, not an upstream patch.
+
+// Measurement scaffolding: doc comments on counters and Debug impls would be noise
+// on a module that only ever prints JSON.
+#![allow(missing_docs, missing_debug_implementations)]
+
+use std::{
+    mem::size_of,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Mutex, OnceLock,
+    },
+    time::Instant,
+};
+
+use group::ff::Field;
+
+/// True when `ORCHARD_H7` is present. Cached: consulted once per `evaluate`.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    // `ORCHARD_H7=0` must switch the counters off: the run mode sets the variable
+    // for itself when it is absent, so presence alone cannot mean "on".
+    *ON.get_or_init(|| {
+        std::env::var_os("ORCHARD_H7").is_some_and(|v| v != std::ffi::OsStr::new("0"))
+    })
+}
+
+/// How many times to re-run the formulation bench (0 = don't).
+pub fn bench_reps() -> usize {
+    static N: OnceLock<usize> = OnceLock::new();
+    *N.get_or_init(|| {
+        std::env::var("ORCHARD_H7_BENCH")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+/// The five allocation sites of the rewritten `recurse`, plus the two leaf
+/// outcomes and the two in-place outcomes. Relaxed ordering throughout: these
+/// are counters, and the report is read after the proving run has joined its
+/// threads.
+pub struct Counters {
+    /// Every `Ast::Poly` visited, across all chunks.
+    leaf_visits: AtomicU64,
+    /// …of those, returned as a borrow into the registered polynomial.
+    leaf_borrowed: AtomicU64,
+    /// …of those, materialised (non-zero rotation).
+    leaf_copied: AtomicU64,
+    /// Bytes written by those materialisations.
+    copy_bytes: AtomicU64,
+    /// Fresh `Vec`s created, over the whole tree.
+    allocs: AtomicU64,
+    /// Bytes of those fresh `Vec`s (`len * size_of::<F>()`).
+    alloc_bytes: AtomicU64,
+    /// Nodes that folded into an existing owned buffer (left operand owned).
+    reuse_left: AtomicU64,
+    /// Nodes that folded into the right operand instead (left was borrowed).
+    reuse_right: AtomicU64,
+    /// Two-input nodes where both operands were borrowed, so a buffer was made.
+    both_borrowed: AtomicU64,
+    /// Unary nodes (`Scale` / `Neg`) over a borrowed operand.
+    unary_alloc: AtomicU64,
+    /// `constant_term` / `linear_term` buffers (unchanged by H7, counted so the
+    /// "did the cost move somewhere else" question has a number on both sides).
+    fills: AtomicU64,
+    fill_bytes: AtomicU64,
+}
+
+static COUNTERS: Counters = Counters {
+    leaf_visits: AtomicU64::new(0),
+    leaf_borrowed: AtomicU64::new(0),
+    leaf_copied: AtomicU64::new(0),
+    copy_bytes: AtomicU64::new(0),
+    allocs: AtomicU64::new(0),
+    alloc_bytes: AtomicU64::new(0),
+    reuse_left: AtomicU64::new(0),
+    reuse_right: AtomicU64::new(0),
+    both_borrowed: AtomicU64::new(0),
+    unary_alloc: AtomicU64::new(0),
+    fills: AtomicU64::new(0),
+    fill_bytes: AtomicU64::new(0),
+};
+
+impl Counters {
+    #[inline]
+    pub fn leaf_borrowed(&self) {
+        self.leaf_visits.fetch_add(1, Ordering::Relaxed);
+        self.leaf_borrowed.fetch_add(1, Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub fn leaf_copied(&self, elems: usize, elem_size: usize) {
+        self.leaf_visits.fetch_add(1, Ordering::Relaxed);
+        self.leaf_copied.fetch_add(1, Ordering::Relaxed);
+        self.copy_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+        self.allocs.fetch_add(1, Ordering::Relaxed);
+        self.alloc_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+    }
+
+    /// A `Scale` / `Neg` over borrowed input.
+    #[inline]
+    pub fn unary_alloc(&self, elems: usize, elem_size: usize) {
+        self.unary_alloc.fetch_add(1, Ordering::Relaxed);
+        self.allocs.fetch_add(1, Ordering::Relaxed);
+        self.alloc_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+    }
+
+    /// A `constant_term` / `linear_term` buffer.
+    #[inline]
+    pub fn filled(&self, elems: usize, elem_size: usize) {
+        self.fills.fetch_add(1, Ordering::Relaxed);
+        self.fill_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+        self.allocs.fetch_add(1, Ordering::Relaxed);
+        self.alloc_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub fn reuse_left(&self) {
+        self.reuse_left.fetch_add(1, Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub fn reuse_right(&self) {
+        self.reuse_right.fetch_add(1, Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub fn both_borrowed(&self, elems: usize, elem_size: usize) {
+        self.both_borrowed.fetch_add(1, Ordering::Relaxed);
+        self.allocs.fetch_add(1, Ordering::Relaxed);
+        self.alloc_bytes
+            .fetch_add((elems * elem_size) as u64, Ordering::Relaxed);
+    }
+}
+
+/// Hand out the global counters for one `evaluate` call, reset to zero.
+pub fn begin() -> &'static Counters {
+    for c in [
+        &COUNTERS.leaf_visits,
+        &COUNTERS.leaf_borrowed,
+        &COUNTERS.leaf_copied,
+        &COUNTERS.copy_bytes,
+        &COUNTERS.allocs,
+        &COUNTERS.alloc_bytes,
+        &COUNTERS.reuse_left,
+        &COUNTERS.reuse_right,
+        &COUNTERS.both_borrowed,
+        &COUNTERS.unary_alloc,
+        &COUNTERS.fills,
+        &COUNTERS.fill_bytes,
+    ] {
+        c.store(0, Ordering::Relaxed);
+    }
+    &COUNTERS
+}
+
+/// Field order of the snapshot array. `alloc` closure:
+/// `allocs == leaf_copied + both_borrowed + unary_alloc + fills`.
+#[derive(Clone, Copy)]
+struct Entry {
+    poly_len: usize,
+    chunk_size: usize,
+    num_chunks: usize,
+    v: [u64; 12],
+}
+
+fn entries() -> &'static Mutex<Vec<Entry>> {
+    static E: OnceLock<Mutex<Vec<Entry>>> = OnceLock::new();
+    E.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+fn reports() -> &'static Mutex<Vec<String>> {
+    static R: OnceLock<Mutex<Vec<String>>> = OnceLock::new();
+    R.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+/// Snapshot the counters of the call just finished.
+pub fn end(poly_len: usize, chunk_size: usize, num_chunks: usize) {
+    if !enabled() {
+        return;
+    }
+    let c = &COUNTERS;
+    let v = [
+        c.leaf_visits.load(Ordering::Relaxed),
+        c.leaf_borrowed.load(Ordering::Relaxed),
+        c.leaf_copied.load(Ordering::Relaxed),
+        c.copy_bytes.load(Ordering::Relaxed),
+        c.allocs.load(Ordering::Relaxed),
+        c.alloc_bytes.load(Ordering::Relaxed),
+        c.reuse_left.load(Ordering::Relaxed),
+        c.reuse_right.load(Ordering::Relaxed),
+        c.both_borrowed.load(Ordering::Relaxed),
+        c.fills.load(Ordering::Relaxed),
+        c.fill_bytes.load(Ordering::Relaxed),
+        c.unary_alloc.load(Ordering::Relaxed),
+    ];
+    entries().lock().unwrap().push(Entry {
+        poly_len,
+        chunk_size,
+        num_chunks,
+        v,
+    });
+}
+
+/// Push one report part as `key=json`; called by the harness.
+pub fn record_part(key: &str, json: String) {
+    reports().lock().unwrap().push(format!("\"{key}\":{json}"));
+}
+
+pub fn take_report() -> String {
+    let mut parts = std::mem::take(&mut *reports().lock().unwrap());
+    if let Some((_, json)) = &*formulation().lock().unwrap() {
+        parts.push(format!("\"formulation\":{json}"));
+    }
+    format!("{{{}}}", parts.join(","))
+}
+
+/// Fold the recorded calls into `evals` + a total part.
+pub fn flush_evals() {
+    let drained: Vec<Entry> = std::mem::take(&mut *entries().lock().unwrap());
+    if drained.is_empty() {
+        record_part("evals", "{\"calls\":0,\"items\":[]}".to_string());
+        return;
+    }
+    let mut items = Vec::new();
+    let mut total = [0u64; 12];
+    for e in &drained {
+        for (i, x) in e.v.iter().enumerate() {
+            total[i] += *x;
+        }
+        items.push(format!(
+            "{{\"poly_len\":{},\"chunk_size\":{},\"num_chunks\":{},\
+\"leaf_visits\":{},\"leaf_borrowed\":{},\"leaf_copied\":{},\"copy_bytes\":{},\
+\"allocs\":{},\"alloc_bytes\":{},\"reuse_left\":{},\"reuse_right\":{},\
+\"both_borrowed\":{},\"fills\":{},\"fill_bytes\":{},\"unary_alloc\":{}}}",
+            e.poly_len,
+            e.chunk_size,
+            e.num_chunks,
+            e.v[0],
+            e.v[1],
+            e.v[2],
+            e.v[3],
+            e.v[4],
+            e.v[5],
+            e.v[6],
+            e.v[7],
+            e.v[8],
+            e.v[9],
+            e.v[10],
+            e.v[11]
+        ));
+    }
+    record_part(
+        "evals",
+        format!(
+            "{{\"calls\":{},\"leaf_visits\":{},\"leaf_borrowed\":{},\"leaf_copied\":{},\
+\"copy_bytes\":{},\"allocs\":{},\"alloc_bytes\":{},\"reuse_left\":{},\"reuse_right\":{},\
+\"both_borrowed\":{},\"fills\":{},\"fill_bytes\":{},\"unary_alloc\":{},\
+\"closed_leaf\":{},\"closed_alloc\":{},\"items\":[{}]}}",
+            drained.len(),
+            total[0],
+            total[1],
+            total[2],
+            total[3],
+            total[4],
+            total[5],
+            total[6],
+            total[7],
+            total[8],
+            total[9],
+            total[10],
+            total[11],
+            total[1] + total[2] == total[0],
+            total[4] == total[2] + total[8] + total[11] + total[9],
+            items.join(",")
+        ),
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Formulation bench (D4): price `copy + in-place` against `collect(zip)`
+// ---------------------------------------------------------------------------
+
+/// Time the two ways to compute `a * b` into a fresh buffer, on real field
+/// elements, one thread, `reps` rounds each.
+///
+/// `copy_*` is what the H6 evaluator does for a two-leaf product: copy each
+/// operand into its own `Vec`, then multiply one by the other in place.
+/// `collect_*` is what H7 does: read both borrowed operands and write the
+/// product straight out. The difference per element is the atom of the whole
+/// optimisation, so it is priced independently of the prover.
+pub fn bench_formulation<F: Field>(chunk_len: usize, reps: usize) -> String {
+    if reps == 0 || chunk_len == 0 {
+        return "null".to_string();
+    }
+    // `Field` has no `From<u64>`; build distinct non-zero values by accumulation.
+    let a: Vec<F> = {
+        let mut x = F::ONE;
+        (0..chunk_len)
+            .map(|_| {
+                let r = x;
+                x += F::ONE;
+                r
+            })
+            .collect()
+    };
+    let b: Vec<F> = {
+        let mut x = F::ONE + F::ONE;
+        (0..chunk_len)
+            .map(|_| {
+                let r = x;
+                x += F::ONE + F::ONE;
+                r
+            })
+            .collect()
+    };
+
+    let mut sink = F::ZERO;
+
+    let t = Instant::now();
+    for _ in 0..reps {
+        let mut lhs = a.to_vec();
+        let rhs = b.to_vec();
+        for (l, r) in lhs.iter_mut().zip(rhs.iter()) {
+            *l *= *r;
+        }
+        sink += lhs[0];
+        std::hint::black_box(&lhs);
+    }
+    let copy_ms = t.elapsed().as_secs_f64() * 1e3 / reps as f64;
+
+    let t = Instant::now();
+    for _ in 0..reps {
+        let lhs: Vec<F> = a.iter().zip(b.iter()).map(|(l, r)| *l * *r).collect();
+        sink += lhs[0];
+        std::hint::black_box(&lhs);
+    }
+    let collect_ms = t.elapsed().as_secs_f64() * 1e3 / reps as f64;
+
+    // The copy on its own, so the number can be compared with the 1.4814 ns /
+    // element that the LC replication bench measured for a leaf materialisation.
+    let t = Instant::now();
+    for _ in 0..reps {
+        let v = a.to_vec();
+        sink += v[0];
+        std::hint::black_box(&v);
+    }
+    let copy_only_ms = t.elapsed().as_secs_f64() * 1e3 / reps as f64;
+
+    let n = chunk_len as f64;
+    format!(
+        "{{\"chunk_len\":{},\"reps\":{},\"copy_mul_ms\":{:.4},\"copy_mul_ns_per_elem\":{:.4},\
+\"collect_ms\":{:.4},\"collect_ns_per_elem\":{:.4},\"copy_only_ms\":{:.4},\
+\"copy_only_ns_per_elem\":{:.4},\"ratio\":{:.4},\"sink_is_nonzero\":{}}}",
+        chunk_len,
+        reps,
+        copy_ms,
+        copy_ms * 1e6 / n,
+        collect_ms,
+        collect_ms * 1e6 / n,
+        copy_only_ms,
+        copy_only_ms * 1e6 / n,
+        copy_ms / collect_ms,
+        !bool::from(sink.is_zero())
+    )
+}
+
+fn formulation() -> &'static Mutex<Option<(usize, String)>> {
+    static F: OnceLock<Mutex<Option<(usize, String)>>> = OnceLock::new();
+    F.get_or_init(|| Mutex::new(None))
+}
+
+/// Run after an `evaluate` (never inside a timed window) and re-run whenever a
+/// larger chunk shows up, because the price per element depends on whether the
+/// buffer still fits in L2. The prover's first evaluations are small (the
+/// permutation and lookup arguments use `n`, not `extended_len`), so keying off
+/// the first call alone would price a 16 KiB copy and call it the real thing.
+///
+/// Two geometries are priced: the chunk (`chunk_len` elements, the unit
+/// `recurse` actually works in) and the whole polynomial (`poly_len`, which is
+/// what the LC replication bench measured, so the two numbers are comparable).
+pub fn maybe_bench<F: Field>(chunk_len: usize, poly_len: usize) {
+    if bench_reps() == 0 {
+        return;
+    }
+    let mut slot = formulation().lock().unwrap();
+    if let Some((best, _)) = &*slot {
+        if *best >= chunk_len {
+            return;
+        }
+    }
+    let chunk = bench_formulation::<F>(chunk_len, bench_reps());
+    let poly = bench_formulation::<F>(poly_len, bench_reps());
+    *slot = Some((chunk_len, format!("{{\"chunk\":{chunk},\"poly\":{poly}}}")));
+}
+
+#[inline]
+pub fn elem_size<F>() -> usize {
+    size_of::<F>()
+}
