+//! Stage F3 · LC: a census of `Ast::Poly` leaf uses.
+//!
+//! Inert unless `ORCHARD_F3_LC` is set. The census is taken by walking the
+//! already-built `Ast` once, *before* the real evaluation runs; `recurse` is not
+//! touched, so every value the prover computes is bit-identical with the probe
+//! on or off. This module only turns the resulting counts into JSON.
+//!
+//! Why a census and not a profiler: "how much would a leaf cache save" is not a
+//! question about samples. It is a question about how many times one leaf's
+//! chunk is materialised, and whether the materialisation was avoidable in the
+//! first place. Both are properties of the tree, not of the clock.
+//!
+//! The distinction that matters (see `docs/orchard/17_leaf_cache_prereg.md` §1):
+//!
+//! * In an **accumulator** position (`Add`/`Mul` left operand, the child of
+//!   `Scale`/`Neg`, the tree root) the value is mutated in place, so a cache hit
+//!   still needs one writable buffer. Bytes moved are unchanged.
+//! * In a **read-only** position (`Add`/`Mul` right operand, every
+//!   `DistributePowers` term) the value is only read, so a cache hit can hand
+//!   out a `&[F]` and the materialisation disappears entirely.
+//!
+//! Only the second kind is genuinely avoidable, which is why the earlier
+//! "2.3 GB of copies" figure needed re-deriving rather than inheriting.
+
+// Measurement scaffolding: same rationale as `f2` -- this module only ever
+// prints JSON, so per-field doc comments and Debug impls would be noise.
+#![allow(missing_docs, missing_debug_implementations)]
+
+use std::sync::{Mutex, OnceLock};
+
+/// True when `ORCHARD_F3_LC` is present and not `0`. Cached: called once per
+/// `evaluate`.
+///
+/// The literal `0` counts as off so that the *same binary* that carries the
+/// probe can also run the control arm -- same seed, same blinders, so the proof
+/// bytes must match bit for bit.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| match std::env::var_os("ORCHARD_F3_LC") {
+        Some(v) => v != "0",
+        None => false,
+    })
+}
+
+/// How many times to replay the leaf materialisations for a per-chunk cost
+/// (`ORCHARD_F3_LC_BENCH`, 0 = don't). Runs after the real evaluation, on the
+/// calling thread only, and is never included in a timing figure.
+pub fn bench_reps() -> usize {
+    static N: OnceLock<usize> = OnceLock::new();
+    *N.get_or_init(|| {
+        std::env::var("ORCHARD_F3_LC_BENCH")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+/// Cost of materialising one leaf chunk, measured by replaying the real
+/// `get_chunk_of_rotated` on the real polynomials.
+pub struct Bench {
+    pub reps: usize,
+    pub chunks: u64,
+    pub ns_per_chunk: f64,
+    pub ns_per_elem: f64,
+    /// Effective read throughput of the materialisation (`chunk_size * 4 B * 8`
+    /// per element is not assumed; the element size is passed in).
+    pub gbps: f64,
+}
+
+/// One `Evaluator::evaluate` invocation, as far as its leaves are concerned.
+pub struct LeafRecord {
+    pub poly_len: usize,
+    pub chunk_size: usize,
+    pub num_chunks: usize,
+    /// `self.polys.len()` at evaluation time: the namespace the `index` field of
+    /// every leaf is scoped to.
+    pub registered: usize,
+    pub visits: u64,
+    pub distinct: u64,
+    pub own: u64,
+    pub borrow: u64,
+    /// Leaves that appear at least once in a read-only position.
+    pub distinct_with_borrow: u64,
+    /// `(index, rotation, own, borrow)` for every distinct leaf.
+    pub leaves: Vec<(usize, i32, u64, u64)>,
+    pub bench: Option<Bench>,
+    pub elem_bytes: usize,
+}
+
+impl LeafRecord {
+    /// Chunk-equivalents a cache can skip: every read-only hit except each
+    /// leaf's compulsory first materialisation. Deliberately conservative --
+    /// when a leaf's first use is in an accumulator position the real saving is
+    /// one chunk larger, and the census does not claim it.
+    pub fn saved_chunks(&self) -> u64 {
+        self.borrow.saturating_sub(self.distinct_with_borrow)
+    }
+
+    /// Bytes the evaluator moves today just to materialise leaves.
+    pub fn leaf_bytes(&self) -> u64 {
+        self.visits * self.poly_len as u64 * self.elem_bytes as u64
+    }
+
+    /// Bytes that stop moving if every read-only hit is served from a cache.
+    pub fn saved_bytes(&self) -> u64 {
+        self.saved_chunks() * self.poly_len as u64 * self.elem_bytes as u64
+    }
+
+    /// Residence for the whole-vector model: one materialisation per distinct
+    /// leaf, shared by every chunk.
+    pub fn cache_bytes(&self) -> u64 {
+        self.distinct * self.poly_len as u64 * self.elem_bytes as u64
+    }
+
+    /// Residence for the per-chunk model: each concurrent chunk caches its own
+    /// slice, so one thread's working set is this much.
+    pub fn per_thread_bytes(&self) -> u64 {
+        self.distinct * self.chunk_size as u64 * self.elem_bytes as u64
+    }
+
+    /// Accumulator hits still pay one copy. Reported so the "saved" figure can
+    /// be checked against "not saved" rather than standing alone.
+    pub fn own_bytes(&self) -> u64 {
+        self.own * self.poly_len as u64 * self.elem_bytes as u64
+    }
+
+    fn to_json(&self) -> String {
+        let mut leaves: Vec<&(usize, i32, u64, u64)> = self.leaves.iter().collect();
+        leaves.sort_by(|a, b| (b.2 + b.3).cmp(&(a.2 + a.3)));
+        let leaf_json = leaves
+            .iter()
+            .map(|(i, r, o, b)| format!("[{i},{r},{o},{b}]"))
+            .collect::<Vec<_>>()
+            .join(",");
+        let bench = match &self.bench {
+            Some(b) => format!(
+                "{{\"reps\":{},\"chunks\":{},\"ns_per_chunk\":{:.3},\"ns_per_elem\":{:.4},\
+\"gbps\":{:.3}}}",
+                b.reps, b.chunks, b.ns_per_chunk, b.ns_per_elem, b.gbps
+            ),
+            None => "null".to_string(),
+        };
+        format!(
+            "{{\"poly_len\":{},\"chunk_size\":{},\"num_chunks\":{},\"registered\":{},\
+\"visits\":{},\"distinct\":{},\"own\":{},\"borrow\":{},\"distinct_with_borrow\":{},\
+\"saved_chunks\":{},\"leaf_bytes\":{},\"saved_bytes\":{},\"own_bytes\":{},\
+\"cache_bytes\":{},\"per_thread_bytes\":{},\"elem_bytes\":{},\
+\"bench\":{},\"leaves\":[{}]}}",
+            self.poly_len,
+            self.chunk_size,
+            self.num_chunks,
+            self.registered,
+            self.visits,
+            self.distinct,
+            self.own,
+            self.borrow,
+            self.distinct_with_borrow,
+            self.saved_chunks(),
+            self.leaf_bytes(),
+            self.saved_bytes(),
+            self.own_bytes(),
+            self.cache_bytes(),
+            self.per_thread_bytes(),
+            self.elem_bytes,
+            bench,
+            leaf_json
+        )
+    }
+}
+
+static RECORDS: OnceLock<Mutex<Vec<LeafRecord>>> = OnceLock::new();
+
+fn records() -> &'static Mutex<Vec<LeafRecord>> {
+    RECORDS.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+/// Record one evaluation's leaf census.
+pub fn record(rec: LeafRecord) {
+    if !enabled() {
+        return;
+    }
+    records().lock().unwrap().push(rec);
+}
+
+/// Drain every recorded call into one JSON object.
+///
+/// Totals sum the quantities that are additive across calls (visits, bytes).
+/// `distinct` and the residence figures are not: two calls share a leaf
+/// namespace only if they come from the same `Evaluator`, so the report keeps
+/// the per-call values and a `max` rather than a meaningless sum.
+pub fn take_report() -> String {
+    let drained: Vec<LeafRecord> = std::mem::take(&mut *records().lock().unwrap());
+    if drained.is_empty() {
+        return "{\"calls\":[]}".to_string();
+    }
+    let visits: u64 = drained.iter().map(|r| r.visits).sum();
+    let saved_bytes: u64 = drained.iter().map(|r| r.saved_bytes()).sum();
+    let leaf_bytes: u64 = drained.iter().map(|r| r.leaf_bytes()).sum();
+    let own_bytes: u64 = drained.iter().map(|r| r.own_bytes()).sum();
+    let max_distinct = drained.iter().map(|r| r.distinct).max().unwrap_or(0);
+    let max_cache = drained.iter().map(|r| r.cache_bytes()).max().unwrap_or(0);
+    let saved_chunks: u64 = drained.iter().map(|r| r.saved_chunks()).sum();
+    let items = drained
+        .iter()
+        .map(|r| r.to_json())
+        .collect::<Vec<_>>()
+        .join(",");
+    format!(
+        "{{\"calls\":[{}],\"totals\":{{\"calls\":{},\"visits\":{},\"saved_chunks\":{},\
+\"leaf_bytes\":{},\"saved_bytes\":{},\"own_bytes\":{},\"max_distinct\":{},\
+\"max_cache_bytes\":{}}}}}",
+        items,
+        drained.len(),
+        visits,
+        saved_chunks,
+        leaf_bytes,
+        saved_bytes,
+        own_bytes,
+        max_distinct,
+        max_cache
+    )
+}
