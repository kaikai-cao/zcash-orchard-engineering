+
+    // -----------------------------------------------------------------------
+    // Stage F3 · LC: leaf-use census
+    // -----------------------------------------------------------------------
+
+    /// Walk the tree once and report how often each leaf is materialised, split
+    /// by whether the position forces a writable buffer or only a read.
+    ///
+    /// Called from [`Self::evaluate`] *before* the real evaluation, so the
+    /// numbers describe the exact tree and the exact chunk geometry that the
+    /// prover is about to use. No value is read or written here.
+    fn f3lc_probe(&self, ast: &Ast<E, F, B>, domain: &EvaluationDomain<F>)
+    where
+        E: Copy + Send + Sync,
+        F: WithSmallOrderMulGroup<3>,
+        B: BasisOps,
+    {
+        let poly_len = self.polys.first().unwrap().len();
+        let (chunk_size, num_chunks) = get_chunk_params(poly_len);
+
+        let mut uses: std::collections::HashMap<(usize, i32), (u64, u64)> =
+            std::collections::HashMap::new();
+        let mut visits = 0u64;
+        // The root leaves `recurse` straight into `out.copy_from_slice`, so it
+        // is an accumulator: it must exist as a buffer either way.
+        f3lc_walk(ast, true, &mut uses, &mut visits);
+
+        let own: u64 = uses.values().map(|(o, _)| *o).sum();
+        let borrow: u64 = uses.values().map(|(_, b)| *b).sum();
+        let distinct_with_borrow = uses.values().filter(|(_, b)| *b > 0).count() as u64;
+
+        let reps = crate::f3lc::bench_reps();
+        let bench = if reps > 0 {
+            Some(self.f3lc_bench(domain, &uses, chunk_size, num_chunks, reps))
+        } else {
+            None
+        };
+
+        let mut leaves: Vec<(usize, i32, u64, u64)> = uses
+            .into_iter()
+            .map(|((index, rotation), (o, b))| (index, rotation, o, b))
+            .collect();
+        leaves.sort_unstable();
+
+        crate::f3lc::record(crate::f3lc::LeafRecord {
+            poly_len,
+            chunk_size,
+            num_chunks,
+            registered: self.polys.len(),
+            visits,
+            distinct: leaves.len() as u64,
+            own,
+            borrow,
+            distinct_with_borrow,
+            leaves,
+            bench,
+            elem_bytes: std::mem::size_of::<F>(),
+        });
+    }
+
+    /// Replay every distinct leaf's materialisation `reps` times and time it.
+    ///
+    /// Runs after the real evaluation and outside any timed region. Single
+    /// threaded on purpose: the point is the marginal cost of one
+    /// `get_chunk_of_rotated` call, not the prover's throughput.
+    fn f3lc_bench(
+        &self,
+        domain: &EvaluationDomain<F>,
+        uses: &std::collections::HashMap<(usize, i32), (u64, u64)>,
+        chunk_size: usize,
+        num_chunks: usize,
+        reps: usize,
+    ) -> crate::f3lc::Bench
+    where
+        F: WithSmallOrderMulGroup<3>,
+        B: BasisOps,
+    {
+        let keys: Vec<(usize, i32)> = uses.keys().copied().collect();
+        let mut acc = F::ZERO;
+        let t = std::time::Instant::now();
+        for _ in 0..reps {
+            for &(index, rotation) in keys.iter() {
+                for chunk_index in 0..num_chunks {
+                    let v = B::get_chunk_of_rotated(
+                        domain,
+                        chunk_size,
+                        chunk_index,
+                        &self.polys[index],
+                        Rotation(rotation),
+                    );
+                    acc += v[0];
+                    std::hint::black_box(&v);
+                }
+            }
+        }
+        let ns = t.elapsed().as_nanos() as f64;
+        std::hint::black_box(acc);
+
+        let chunks = (reps * keys.len() * num_chunks) as u64;
+        let elems = chunks * chunk_size as u64;
+        let ns_per_chunk = ns / chunks as f64;
+        let ns_per_elem = ns / elems as f64;
+        crate::f3lc::Bench {
+            reps,
+            chunks,
+            ns_per_chunk,
+            ns_per_elem,
+            gbps: (std::mem::size_of::<F>() as f64) / ns_per_elem,
+        }
+    }
+}
+
+/// Position-aware leaf walk for the Stage F3 · LC census.
+///
+/// `accumulator = true` means the caller will mutate the value in place
+/// (`Add`/`Mul` left operand, the single child of `Scale`/`Neg`, the root);
+/// `false` means it is only read (`Add`/`Mul` right operand, a
+/// `DistributePowers` term). The distinction is the whole point: a cache hit in
+/// the second position moves zero bytes, in the first it still moves one chunk.
+fn f3lc_walk<E, F: Field, B: Basis>(
+    ast: &Ast<E, F, B>,
+    accumulator: bool,
+    uses: &mut std::collections::HashMap<(usize, i32), (u64, u64)>,
+    visits: &mut u64,
+) {
+    match ast {
+        Ast::Poly(leaf) => {
+            *visits += 1;
+            let entry = uses
+                .entry((leaf.index, leaf.rotation.0))
+                .or_insert((0, 0));
+            if accumulator {
+                entry.0 += 1;
+            } else {
+                entry.1 += 1;
+            }
+        }
+        Ast::Add(a, b) => {
+            f3lc_walk(a, true, uses, visits);
+            f3lc_walk(b, false, uses, visits);
+        }
+        Ast::Mul(AstMul(a, b)) => {
+            f3lc_walk(a, true, uses, visits);
+            f3lc_walk(b, false, uses, visits);
+        }
+        Ast::Scale(a, _) | Ast::Neg(a) => f3lc_walk(a, true, uses, visits),
+        // The fold writes into its own accumulator and only reads each term.
+        Ast::DistributePowers(terms, _) => {
+            for term in terms.iter() {
+                f3lc_walk(term, false, uses, visits);
+            }
+        }
+        Ast::LinearTerm(_) | Ast::ConstantTerm(_) => {}
+    }
 }
 
