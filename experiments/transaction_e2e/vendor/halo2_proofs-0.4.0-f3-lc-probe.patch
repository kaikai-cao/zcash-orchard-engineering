+    // -----------------------------------------------------------------------
+    // Stage F3 / LC: is a leaf cache keyed on `(index, rotation)` safe?
+    //
+    // Two claims have to hold for the census to mean anything, and both are
+    // checked here rather than asserted in prose:
+    //   1. within one context the materialisation is a pure function, so a
+    //      second materialisation of the same leaf is bit-identical;
+    //   2. across contexts it is *not*, so the key must carry the domain shape.
+    // The second one is the trap: `get_chunk_of_rotated_extended` multiplies
+    // the rotation by `2^(extended_k - k)`, which is a property of the eval
+    // domain, not of the leaf.
+    // -----------------------------------------------------------------------
+    mod lc {
+        use std::collections::HashMap;
+        use std::marker::PhantomData;
+        use std::sync::Arc;
+
+        use group::ff::Field as _;
+        use pasta_curves::pallas::Base;
+
+        use super::super::{
+            f3lc_walk, Ast, AstLeaf, AstMul, BasisOps, EvaluationDomain, Polynomial,
+        };
+        use crate::poly::{ExtendedLagrangeCoeff, Rotation};
+
+        type Ev = fn();
+        type ExtAst = Ast<Ev, Base, ExtendedLagrangeCoeff>;
+
+        fn leaf(index: usize, rotation: i32) -> Ast<Ev, Base, ExtendedLagrangeCoeff> {
+            Ast::Poly(AstLeaf {
+                index,
+                rotation: Rotation(rotation),
+                _evaluator: PhantomData,
+            })
+        }
+
+        fn ramp(len: usize) -> Polynomial<Base, ExtendedLagrangeCoeff> {
+            Polynomial {
+                values: (0..len as u64).map(Base::from).collect(),
+                _marker: PhantomData,
+            }
+        }
+
+        #[test]
+        fn leaf_materialisation_is_repeatable_in_one_context() {
+            // Premise of any cache: same poly, same domain, same chunk => same
+            // bytes. If this failed, a cache would need to be invalidated by
+            // something the census does not model.
+            let domain = EvaluationDomain::new(2, 5);
+            let poly = ramp(domain.extended_len());
+            for rotation in [0i32, 1, -1, 3] {
+                for chunk_index in 0..4usize {
+                    let a = ExtendedLagrangeCoeff::get_chunk_of_rotated(
+                        &domain, 8, chunk_index, &poly, Rotation(rotation),
+                    );
+                    let b = ExtendedLagrangeCoeff::get_chunk_of_rotated(
+                        &domain, 8, chunk_index, &poly, Rotation(rotation),
+                    );
+                    assert_eq!(a, b, "rotation {rotation}, chunk {chunk_index}");
+                }
+            }
+        }
+
+        #[test]
+        fn leaf_materialisation_depends_on_domain_shape() {
+            // Same polynomial length (32), same rotation, same chunk -- but the
+            // domains disagree on `(k, extended_k)`: 2^5 with qpd 1 versus 2^3
+            // with qpd 3. The extended rotation is scaled by 2^(ext_k - k), i.e.
+            // 1 versus 4, so the two chunks are different slices. This is why a
+            // cache key of `(index, rotation)` alone would be wrong the moment
+            // one evaluator is used with two domains.
+            let a = EvaluationDomain::new(2, 5);
+            let b = EvaluationDomain::new(4, 3);
+            assert_eq!(a.extended_len(), b.extended_len());
+
+            let poly = ramp(a.extended_len());
+            let ra =
+                ExtendedLagrangeCoeff::get_chunk_of_rotated(&a, 8, 0, &poly, Rotation(1));
+            let rb =
+                ExtendedLagrangeCoeff::get_chunk_of_rotated(&b, 8, 0, &poly, Rotation(1));
+            assert_ne!(
+                ra, rb,
+                "the same (index, rotation, chunk) must not be assumed domain-free"
+            );
+        }
+
+        #[test]
+        fn census_splits_accumulator_from_readonly() {
+            // (a + b) * a : the inner `Add` accumulates into `a`, the outer
+            // `Mul` only reads its right operand, so `a` is one accumulator use
+            // and one read-only use, while `b` is read-only.
+            let ast: ExtAst = Ast::Mul(AstMul(
+                Arc::new(Ast::Add(
+                    Arc::new(leaf(0, 0)),
+                    Arc::new(leaf(1, 0)),
+                )),
+                Arc::new(leaf(0, 0)),
+            ));
+            let mut uses: HashMap<(usize, i32), (u64, u64)> = HashMap::new();
+            let mut visits = 0u64;
+            f3lc_walk(&ast, true, &mut uses, &mut visits);
+
+            assert_eq!(visits, 3);
+            assert_eq!(uses.len(), 2);
+            assert_eq!(uses[&(0, 0)], (1, 1));
+            assert_eq!(uses[&(1, 0)], (0, 1));
+        }
+
+        #[test]
+        fn distribute_powers_terms_are_readonly() {
+            // The fold writes into its own accumulator, so no term is in a
+            // writable position even when the term *is* a leaf.
+            let ast: ExtAst = Ast::distribute_powers(
+                vec![leaf(0, 0), leaf(1, -1)],
+                Base::from(7u64),
+            );
+            let mut uses: HashMap<(usize, i32), (u64, u64)> = HashMap::new();
+            let mut visits = 0u64;
+            f3lc_walk(&ast, true, &mut uses, &mut visits);
+
+            assert_eq!(visits, 2);
+            assert_eq!(uses[&(0, 0)], (0, 1));
+            assert_eq!(uses[&(1, -1)], (0, 1));
+        }
+    }
 }
 
