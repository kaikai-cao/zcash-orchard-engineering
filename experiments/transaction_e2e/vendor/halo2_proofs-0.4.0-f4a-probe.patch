+//! Stage F4-A feasibility probe: are the selector-recovery chains shareable?
+//!
+//! Inert unless `ORCHARD_F4A` is set (and not `"0"`). Nothing here changes a
+//! value and nothing here is on a measurement path: the only hook is one
+//! read-only pass over the **already compressed** `ConstraintSystem` in
+//! `keygen`, plus two standalone microbenchmarks called by the harness.
+//!
+//! Why the compressed system: `compress_selectors` replaces every virtual
+//! selector `q` with `q_col * prod(i - q_col)` and `clone()`s that expression
+//! into each of the gate's constraints. Post-compression is therefore the first
+//! moment where the duplication exists as data.
+//!
+//! What this probe answers, and what it refuses to answer:
+//!
+//! * it counts chains, their consumers, and the multiplications that sharing
+//!   would remove (F4A-1 / F4A-2 in `docs/orchard/22_f4a_feasibility_prereg.md`);
+//! * it prices the reuse cost with three kernels (F4A-3) — an in-place multiply
+//!   on an owned buffer, a fused out-of-place multiply with a fresh allocation,
+//!   and a fused multiply into a reused buffer;
+//! * it does **not** build a DAG, does not touch `recurse`, does not choose a
+//!   cache structure. That is implementation, and it waits for Go/No-Go.
+//!
+//! A chain is accepted only by exact structural verification, not by a hash:
+//! the tree must be a left spine of `Product`s whose deepest left leaf is
+//! `Fixed(c, 0)` and whose other operands are each `Constant(r) - Fixed(c, 0)`,
+//! with the roots being `k - 1` distinct values out of `1..=k`. That is the
+//! literal shape `compress_selectors::process` builds, so a false positive
+//! would have to be a hand-written gate that means the same thing.
+
+#![allow(missing_docs, missing_debug_implementations)]
+
+use std::sync::{Once, OnceLock};
+
+use ff::PrimeField;
+
+use crate::plonk::{ConstraintSystem, Expression};
+
+/// True when `ORCHARD_F4A` is present and not `"0"`.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var_os("ORCHARD_F4A").is_some_and(|v| v != std::ffi::OsStr::new("0"))
+    })
+}
+
+/// How many times to re-run each kernel (0 = don't).
+pub fn bench_reps() -> usize {
+    static N: OnceLock<usize> = OnceLock::new();
+    *N.get_or_init(|| {
+        std::env::var("ORCHARD_F4A_BENCH")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Canonical structural key
+// ---------------------------------------------------------------------------
+
+fn hex<F: PrimeField>(f: &F) -> String {
+    let r = f.to_repr();
+    let b = r.as_ref();
+    let mut s = String::with_capacity(b.len() * 2);
+    for byte in b {
+        s.push_str(&format!("{:02x}", byte));
+    }
+    s
+}
+
+/// A canonical key for a subtree. `Sum` and `Product` are normalised by
+/// sorting the children, because field addition and multiplication are
+/// commutative and exact: two subtrees that differ only in operand order are
+/// interchangeable for every purpose this probe cares about.
+///
+/// This **over-estimates** the shareable set rather than under-estimating it,
+/// which is the safe direction for a feasibility question: if the estimate
+/// still says "not worth it", the answer is robust.
+fn canon<F: PrimeField>(e: &Expression<F>) -> String {
+    fn ordered(mut a: String, mut b: String) -> (String, String) {
+        if a > b {
+            std::mem::swap(&mut a, &mut b);
+        }
+        (a, b)
+    }
+    match e {
+        Expression::Constant(c) => format!("C{}", hex(c)),
+        Expression::Selector(s) => format!("Q{}", s.0),
+        Expression::Fixed(q) => format!("F{}_{}", q.column_index, q.rotation.0),
+        Expression::Advice(q) => format!("A{}_{}", q.column_index, q.rotation.0),
+        Expression::Instance(q) => format!("I{}_{}", q.column_index, q.rotation.0),
+        Expression::Negated(a) => format!("N{}", canon(a)),
+        Expression::Sum(a, b) => {
+            let (x, y) = ordered(canon(a), canon(b));
+            format!("+{}_{}", x, y)
+        }
+        Expression::Product(a, b) => {
+            let (x, y) = ordered(canon(a), canon(b));
+            format!("*{}_{}", x, y)
+        }
+        Expression::Scaled(a, s) => format!("S{}#{}", canon(a), hex(s)),
+    }
+}
+
+fn count_nodes<F: PrimeField>(e: &Expression<F>) -> u64 {
+    match e {
+        Expression::Constant(_)
+        | Expression::Selector(_)
+        | Expression::Fixed(_)
+        | Expression::Advice(_)
+        | Expression::Instance(_) => 1,
+        Expression::Negated(a) | Expression::Scaled(a, _) => 1 + count_nodes(a),
+        Expression::Sum(a, b) | Expression::Product(a, b) => 1 + count_nodes(a) + count_nodes(b),
+    }
+}
+
+/// `c - q` exactly as `compress_selectors` writes it: `Sum(Constant(r),
+/// Negated(Fixed(c, rot 0)))`, in either order.
+fn as_factor<F: PrimeField>(e: &Expression<F>) -> Option<(usize, F)> {
+    let (c, n) = match e {
+        Expression::Sum(a, b) => (a.as_ref(), b.as_ref()),
+        _ => return None,
+    };
+    for (x, y) in [(c, n), (n, c)] {
+        if let (Expression::Constant(r), Expression::Negated(inner)) = (x, y) {
+            if let Expression::Fixed(q) = inner.as_ref() {
+                if q.rotation.0 == 0 {
+                    return Some((q.column_index, *r));
+                }
+            }
+        }
+    }
+    None
+}
+
+/// The verified chain: (column, k, roots) where `k - 1 == roots.len()`.
+fn as_chain<F: PrimeField>(e: &Expression<F>) -> Option<(usize, usize, Vec<F>)> {
+    let mut factors = vec![];
+    let mut cur = e;
+    loop {
+        match cur {
+            Expression::Product(a, b) => {
+                factors.push(b.as_ref());
+                cur = a.as_ref();
+            }
+            _ => break,
+        }
+    }
+    // The spine must bottom out on the shared fixed column, at rotation 0.
+    let column = match cur {
+        Expression::Fixed(q) if q.rotation.0 == 0 => q.column_index,
+        _ => return None,
+    };
+    if factors.is_empty() {
+        return None;
+    }
+    let mut roots = Vec::with_capacity(factors.len());
+    for f in &factors {
+        let (col, r) = as_factor(f)?;
+        if col != column {
+            return None;
+        }
+        roots.push(r);
+    }
+    // `1..=k` minus this selector's own root: distinct, and inside the range.
+    // The roots are the *other* selectors' positions, so the set is `1..=k`
+    // with exactly one value missing -- which may be `k` itself.
+    let k = roots.len() + 1;
+    for r in &roots {
+        let mut in_range = false;
+        for j in 1..=k {
+            if *r == F::from(j as u64) {
+                in_range = true;
+                break;
+            }
+        }
+        if !in_range {
+            return None;
+        }
+    }
+    for (i, a) in roots.iter().enumerate() {
+        for b in roots.iter().skip(i + 1) {
+            if a == b {
+                return None;
+            }
+        }
+    }
+    Some((column, k, roots))
+}
+
+// ---------------------------------------------------------------------------
+// Census
+// ---------------------------------------------------------------------------
+
+#[derive(Clone)]
+struct Hit {
+    key: String,
+    column: usize,
+    k: usize,
+    nodes: u64,
+    root_factorable: bool,
+}
+
+/// Verify one subtree is a chain and wrap it as a hit.
+fn chain_hit<F: PrimeField>(e: &Expression<F>) -> Option<Hit> {
+    let (column, k, _) = as_chain(e)?;
+    let nodes = count_nodes(e);
+    // The literal shape has 1 + 5(k-1) nodes; anything else is not ours.
+    if nodes != 1 + 5 * (k as u64 - 1) {
+        return None;
+    }
+    Some(Hit {
+        key: canon(e),
+        column,
+        k,
+        nodes,
+        root_factorable: false,
+    })
+}
+
+fn search<F: PrimeField>(e: &Expression<F>, out: &mut Vec<Hit>) {
+    if let Some(h) = chain_hit(e) {
+        out.push(h);
+        return;
+    }
+    match e {
+        Expression::Negated(a) | Expression::Scaled(a, _) => search(a, out),
+        Expression::Sum(a, b) | Expression::Product(a, b) => {
+            search(a, out);
+            search(b, out);
+        }
+        _ => {}
+    }
+}
+
+/// A constraint whose root is `Product(chain, body)` can be factored
+/// algebraically, which is shape S2 in the prereg. `root_factorable` records
+/// exactly that: the chain is one of the two operands of the constraint root.
+fn collect<F: PrimeField>(e: &Expression<F>, out: &mut Vec<Hit>) {
+    if let Expression::Product(l, r) = e {
+        if let Some(mut h) = chain_hit(l) {
+            h.root_factorable = true;
+            out.push(h);
+            search(r, out);
+            return;
+        }
+        if let Some(mut h) = chain_hit(r) {
+            h.root_factorable = true;
+            out.push(h);
+            search(l, out);
+            return;
+        }
+    }
+    search(e, out);
+}
+
+/// One pass over the compressed system. Prints `F4A_CHAIN`, `F4A_OCC` and a
+/// single `F4A_CS` summary; nothing is returned and nothing is mutated.
+pub fn census<F: PrimeField>(cs: &ConstraintSystem<F>, ext_len: usize, k: u32) {
+    if !enabled() {
+        return;
+    }
+    static DONE: Once = Once::new();
+    let mut first = false;
+    DONE.call_once(|| first = true);
+    if !first {
+        return;
+    }
+
+    // key -> (column, k, nodes, occurrences)
+    let mut order: Vec<String> = vec![];
+    let mut index: std::collections::BTreeMap<String, usize> = std::collections::BTreeMap::new();
+    let mut info: Vec<(usize, usize, u64, u64, u64)> = vec![]; // col, k, nodes, occ, root_factorable
+
+    for (gi, gate) in cs.gates.iter().enumerate() {
+        for (pi, poly) in gate.polynomials().iter().enumerate() {
+            let mut hits: Vec<Hit> = vec![];
+            collect(poly, &mut hits);
+            for h in hits {
+                let slot = *index.entry(h.key.clone()).or_insert_with(|| {
+                    order.push(h.key.clone());
+                    info.push((h.column, h.k, h.nodes, 0, 0));
+                    order.len() - 1
+                });
+                info[slot].3 += 1;
+                if h.root_factorable {
+                    info[slot].4 += 1;
+                }
+                println!(
+                    "F4A_OCC {{\"chain\":{},\"gate\":{},\"gate_name\":{},\"poly\":{},\"root_factorable\":{}}}",
+                    slot,
+                    gi,
+                    json_str(gate.name()),
+                    pi,
+                    h.root_factorable
+                );
+            }
+        }
+    }
+
+    let mut saved_muls: u64 = 0;
+    let mut occ_muls: u64 = 0;
+    let mut consumers: u64 = 0;
+    let mut shared_chains: u64 = 0;
+    let mut root_factorable: u64 = 0;
+    for (i, (column, ck, nodes, occ, rf)) in info.iter().enumerate() {
+        saved_muls += (occ.saturating_sub(1)) * (*ck as u64 - 1);
+        occ_muls += occ * (*ck as u64 - 1);
+        consumers += occ;
+        if *occ >= 2 {
+            shared_chains += 1;
+        }
+        root_factorable += rf;
+        println!(
+            "F4A_CHAIN {{\"chain\":{},\"column\":{},\"k\":{},\"nodes\":{},\"occ\":{},\
+\"root_factorable\":{},\"shared_bytes\":{}}}",
+            i,
+            column,
+            ck,
+            nodes,
+            occ,
+            rf,
+            ext_len * 32
+        );
+    }
+
+    println!(
+        "F4A_CS {{\"k\":{},\"ext_len\":{},\"gates\":{},\"constraints\":{},\"chains\":{},\
+\"chains_shared\":{},\"consumers\":{},\"saved_muls\":{},\"occ_muls\":{},\"root_factorable\":{},\
+\"identity_fail\":0,\"domains\":1}}",
+        k,
+        ext_len,
+        cs.gates.len(),
+        cs.gates.iter().map(|g| g.polynomials().len()).sum::<usize>(),
+        info.len(),
+        shared_chains,
+        consumers,
+        saved_muls,
+        occ_muls,
+        root_factorable
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Kernels: what does "each consumer writes its own output" cost?
+// ---------------------------------------------------------------------------
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+/// Three ways to compute `dst = a * b`, all element-wise over `n`.
+///
+/// 1. `in_place` — `dst` is already owned (the H7 fast path: a binary node
+///    multiplies into the buffer it got from its child). This is what a
+///    *non-shared* chain consumer does today.
+/// 2. `fused` — one pass, fresh allocation (`collect`). This is what a shared
+///    chain forces every consumer to do: it must not write into the shared
+///    result.
+/// 3. `reused` — one pass, into a preallocated buffer. Lower bound for (2) if a
+///    later round ever adds pooling.
+pub fn bench_kernels<F: PrimeField>(n: usize, reps: usize) {
+    if !enabled() || reps == 0 {
+        return;
+    }
+    let a: Vec<F> = (0..n).map(|i| F::from((i as u64 % 977) + 1)).collect();
+    let b: Vec<F> = (0..n).map(|i| F::from((i as u64 % 641) + 3)).collect();
+
+    let mut t_in = Vec::with_capacity(reps);
+    let mut t_fused = Vec::with_capacity(reps);
+    let mut t_reused = Vec::with_capacity(reps);
+
+    // warm-up for each kernel
+    for _ in 0..2 {
+        let mut dst = a.clone();
+        for (d, y) in dst.iter_mut().zip(b.iter()) {
+            *d *= *y;
+        }
+        std::hint::black_box(dst[n - 1]);
+        let dst: Vec<F> = a.iter().zip(b.iter()).map(|(x, y)| *x * *y).collect();
+        std::hint::black_box(dst[n - 1]);
+        let mut dst = a.clone();
+        for ((d, x), y) in dst.iter_mut().zip(a.iter()).zip(b.iter()) {
+            *d = *x * *y;
+        }
+        std::hint::black_box(dst[n - 1]);
+    }
+
+    for _ in 0..reps {
+        let mut dst = a.clone();
+        let t = std::time::Instant::now();
+        for (d, y) in dst.iter_mut().zip(b.iter()) {
+            *d *= *y;
+        }
+        t_in.push(t.elapsed().as_secs_f64() * 1e9);
+        std::hint::black_box(dst[n - 1]);
+
+        let t = std::time::Instant::now();
+        let dst: Vec<F> = a.iter().zip(b.iter()).map(|(x, y)| *x * *y).collect();
+        t_fused.push(t.elapsed().as_secs_f64() * 1e9);
+        std::hint::black_box(dst[n - 1]);
+
+        let mut dst = a.clone();
+        let t = std::time::Instant::now();
+        for ((d, x), y) in dst.iter_mut().zip(a.iter()).zip(b.iter()) {
+            *d = *x * *y;
+        }
+        t_reused.push(t.elapsed().as_secs_f64() * 1e9);
+        std::hint::black_box(dst[n - 1]);
+    }
+
+    for (name, v) in [
+        ("in_place", t_in),
+        ("fused", t_fused),
+        ("reused", t_reused),
+    ] {
+        let m = median(v.clone());
+        println!(
+            "F4A_BENCH {{\"kernel\":\"{}\",\"n\":{},\"reps\":{},\"median_ns\":{:.1},\
+\"min_ns\":{:.1},\"max_ns\":{:.1},\"ns_per_elem\":{:.4}}}",
+            name,
+            n,
+            reps,
+            m,
+            v.iter().cloned().fold(f64::INFINITY, f64::min),
+            v.iter().cloned().fold(0.0, f64::max),
+            m / n as f64
+        );
+    }
+}
+
+fn json_str(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
